{
  "Routes": [
    {
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete", "Patch" ],
      "UpstreamPathTemplate": "/{anything}",
      "DownstreamPathTemplate": "/{anything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "api-sco",
          "Port": 8081
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5555" 
  }
}