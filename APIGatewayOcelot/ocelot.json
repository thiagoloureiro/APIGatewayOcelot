{
  "Routes": [
    {
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete", "Patch" ],
      "UpstreamPathTemplate": "/{anything}",
      "DownstreamPathTemplate": "/{anything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 8081
        },
        {
          "Host": "localhost",
          "Port": 8082
        }
      ],
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://+:9999"
  }
}
